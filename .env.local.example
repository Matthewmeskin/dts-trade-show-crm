# Copy this file to `.env.local` and fill in values from your Supabase project
# (Supabase dashboard → Project Settings → API). Never commit `.env.local`.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe for the browser; access is gated by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Bypasses RLS. Used later by the n8n/TMS
# integration endpoint and admin tasks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — powers the dashboard AI summary (claude-opus-4-8).
ANTHROPIC_API_KEY=

# Shared secret for the TMS ingest endpoint (n8n → POST /api/tms/shipments,
# header: Authorization: Bearer <this>). See TMS-INTEGRATION.md.
TMS_WEBHOOK_SECRET=

# GSC Shipping Center requests inbox (lib/ship-pull.ts). The pull runs in the
# 15 minute /api/public-sync cron and uses the sync's TRADE_SHOW_SUPABASE_URL
# and TRADE_SHOW_SUPABASE_PUBLISHABLE_KEY. Its own secret, 48+ random
# characters; the DTS Trade Show project stores only its SHA-256
# (showdata.secret_keys, purpose 'crm_pull'). Unset: the pull is skipped.
TRADE_SHOW_PULL_SECRET=

# Quote emails from the inbox, through Resend on the DTS sending subdomain.
# Unset: the Quote screen offers "Open in Outlook" and "I sent it myself".
RESEND_API_KEY=
SHIP_EMAIL_FROM=

# GSC Shipping Center status feed (lib/ship-push.ts): each leg's status,
# carrier and PRO back to the exhibitor's status page, never a price. Its own
# secret, 48+ characters; the public project stores only its SHA-256
# (purpose 'crm_status'). Unset: nothing is pushed.
TRADE_SHOW_STATUS_SECRET=

# GSC Shipping Center scheduled email (lib/ship-mailer.ts): the GSC's manifest
# and outbound list, and exhibitor reminders. Uses RESEND_API_KEY and
# SHIP_EMAIL_FROM above; nothing sends without them.
# The team inbox the GSC's emails reply to.
SHIP_REPLY_TO=
# Where the Shipping Center is served (https://ship.dtsone.com once DNS is
# set), for "add outbound" and "new status link" links in reminders.
SHIP_BASE_URL=

# GSC logo upload on the Shipping Centers screen (Vercel Blob store, read and
# write token). Unset: the screen takes a logo link instead.
BLOB_READ_WRITE_TOKEN=
